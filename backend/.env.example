# ============================================================
# Appointment Booking Application — Environment Variables
# SRS v1.0, April 2026
# NEVER commit the real .env file to version control.
# All secrets must be injected via environment — SRS Section 5, Page 9
# ============================================================

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database (MySQL 8.0) — SRS Section 5, Page 9 ────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appointment_db
DB_USER=root
DB_PASSWORD=your_strong_db_password_here
# Connection pooling — NFR Scalability, Page 8
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT=30000
DB_IDLE_TIMEOUT=10000

# ─── JWT — RS256 Keys — NFR Security, Page 8 ─────────────────
# Generate with: openssl genrsa -out private.pem 4096
#                openssl rsa -in private.pem -pub out -out public.pem
# Then base64 encode: base64 -w 0 private.pem
# Store the base64 string here — decoded at runtime
JWT_PRIVATE_KEY_BASE64=base64_encoded_rsa_private_key_pem_here
JWT_PUBLIC_KEY_BASE64=base64_encoded_rsa_public_key_pem_here
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ─── bcrypt — NFR Security Page 8: cost factor 12+ ───────────
BCRYPT_COST_FACTOR=12

# ─── Rate Limiting — FR-02, Page 6 ───────────────────────────
# 5 login attempts per 15-minute window per IP
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
# General API limiter
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100


# ─── Email / SMTP — FR-10, Pages 7-8 ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM_NAME=Appointment Booking

# ─── Redis (Job Queue for async email) — FR-10 ───────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Email Verification Token ─────────────────────────────────
# Token TTL in seconds (24 hours)
EMAIL_VERIFICATION_TOKEN_TTL=86400

# ─── Appointment Reminders — FR-10 (optional, admin-configurable)
REMINDER_CRON_SCHEDULE=0 8 * * *
REMINDER_HOURS_BEFORE=24
REMINDER_POLL_INTERVAL_MINUTES=5

# ─── Account Maintenance ───────────────────────────────────────
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
UNVERIFIED_PURGE_INTERVAL_MINUTES=60
