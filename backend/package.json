{
  "name": "appointment-booking-backend",
  "version": "1.0.0",
  "description": "Appointment Booking Application — Backend API. SRS v1.0, April 2026.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
